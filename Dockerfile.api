# ── OLYMPUS v4 — API (Hono + Node.js) ─────────────────────────────────────────
# Usa node:20-slim (Debian Bookworm). NÃO usar Alpine — dependências nativas (bcrypt, pg)
# falham silenciosamente em Alpine.
FROM node:20-slim

WORKDIR /app

# postgresql-client-18 do repositório oficial PGDG (Railway usa PostgreSQL 18).
# O apt do Debian padrão traz client-15 que falha com "version mismatch" contra servidor 18.
# PGDG instala o binário real + todas as dependências (libssl, libkrb5, libldap, etc.)
# sem a instabilidade de copiar libs individualmente entre imagens.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    install -d /usr/share/postgresql-common/pgdg && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
         -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc && \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] \
         https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client-18 && \
    rm -rf /var/lib/apt/lists/*

# Copia todo o monorepo
COPY . .

# Instala dependências do monorepo
# strict-ssl=false contorna falhas de verificação de cadeia SSL em redes corporativas/proxy
RUN npm config set strict-ssl false && npm install

# Resolve duplicatas do drizzle-orm entre workspaces
RUN npm dedupe
RUN rm -rf packages/db/node_modules/drizzle-orm

# Compila todos os pacotes internos (ordem: core → tools → db → api)
RUN npm run build \
    --workspace=@olympus/core \
    --workspace=@olympus/tools \
    --workspace=@olympus/db \
    --workspace=@olympus/api

# Health check — Railway e Docker usam este endpoint para saber se a API está pronta
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3333) + '/ping', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

EXPOSE 3333

# PRODUÇÃO: sempre apontar para o dist/ compilado — NUNCA usar tsx em produção
CMD ["node", "apps/api/dist/index.js"]
