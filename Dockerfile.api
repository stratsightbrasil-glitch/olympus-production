# ── OLYMPUS v4 — API (Hono + Node.js) ─────────────────────────────────────────
# Stage 1: extrai pg_dump da imagem oficial postgres:18 (versão que Railway usa)
# Evita instalar postgresql-client-15 do Debian que rejeita servidor 18+ (version mismatch)
FROM postgres:18-bookworm AS pg_tools

# Stage 2: imagem principal
# Usa node:20-slim (Debian Bookworm). NÃO usar Alpine — dependências nativas (bcrypt, pg)
# falham silenciosamente em Alpine.
FROM node:20-slim

WORKDIR /app

# Copia pg_dump 18 e a libpq necessária do stage anterior
COPY --from=pg_tools /usr/bin/pg_dump /usr/bin/pg_dump
COPY --from=pg_tools /usr/lib/x86_64-linux-gnu/libpq.so.5 /usr/lib/x86_64-linux-gnu/libpq.so.5

# Copia todo o monorepo
COPY . .

# Instala dependências do monorepo
# strict-ssl=false contorna falhas de verificação de cadeia SSL em redes corporativas/proxy
RUN npm config set strict-ssl false && npm install

# Resolve duplicatas do drizzle-orm entre workspaces
RUN npm dedupe
RUN rm -rf packages/db/node_modules/drizzle-orm

# Compila todos os pacotes internos (ordem: core → tools → db → api)
RUN npm run build \
    --workspace=@olympus/core \
    --workspace=@olympus/tools \
    --workspace=@olympus/db \
    --workspace=@olympus/api

# Health check — Railway e Docker usam este endpoint para saber se a API está pronta
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3333) + '/ping', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

EXPOSE 3333

# PRODUÇÃO: sempre apontar para o dist/ compilado — NUNCA usar tsx em produção
CMD ["node", "apps/api/dist/index.js"]
