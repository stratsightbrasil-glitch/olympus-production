# ── OLYMPUS v4 — Variáveis de Ambiente para Railway ───────────────────────────
# Copie este arquivo, preencha os valores e configure no dashboard do Railway
# em: Service → Variables → Raw Editor
# Cada variável deve estar em sua própria linha (nunca \n literal).

# ── LLM ───────────────────────────────────────────────────────────────────────
# Produção (Railway / nuvem): usar Anthropic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# PoC offline / ar-gapped: usar Ollama local
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=llama3.1:8b    # CPU 16 GB — equilibrio qualidade/velocidade
# OLLAMA_MODEL=qwen2.5:7b     # CPU 16 GB — excelente em português
# OLLAMA_MODEL=llama3.3:70b   # GPU 48 GB — qualidade próxima ao Claude
# Para ativar: .\scripts\setup-ollama.ps1 [-Model <nome>]

# ── Busca Web ─────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Railway injeta DATABASE_URL automaticamente ao linkar o addon Postgres.
# NÃO defina manualmente se estiver usando o addon Railway Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Autenticação ──────────────────────────────────────────────────────────────
JWT_SECRET=gere-um-secret-longo-e-aleatorio-aqui-minimo-32-chars

# ── CORS — URL do serviço Web no Railway ──────────────────────────────────────
# Substitua pelo domínio real após o deploy do serviço web.
# Formato Railway padrão: https://olympus-web-production-xxxx.up.railway.app
# Formato domínio próprio: https://athena.stratsight.com.br
ALLOWED_ORIGIN=https://SEU-DOMINIO-WEB.up.railway.app

# ── RAG — Voyage AI ───────────────────────────────────────────────────────────
# dash.voyageai.com — plano gratuito disponível
VOYAGE_API_KEY=pa-...

# ── Alertas KRATOS por e-mail (opcional) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-de-app

# ── DOU — INLABS (opcional) ───────────────────────────────────────────────────
# Cadastro gratuito em inlabs.in.gov.br
INLABS_EMAIL=
INLABS_PASSWORD=

# ── ITU DataHub (opcional) ────────────────────────────────────────────────────
# Cadastro gratuito em datahub.itu.int
ITU_EMAIL=
ITU_PASSWORD=

# ── Node.js ───────────────────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=1024
# PORT é injetado automaticamente pelo Railway — não defina aqui
