# ── OLYMPUS v4 — Variáveis de Ambiente (desenvolvimento local) ─────────────────
# Copie para .env e preencha os valores. Nunca comite o .env com credenciais reais.

# ── Banco de Dados ────────────────────────────────────────────────────────────
# Docker Compose local: postgres container sobe automaticamente via docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/olympus

# ── LLM — Provedor de Linguagem ───────────────────────────────────────────────
# Opção 1 (padrão): Anthropic Claude
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Opção 2: Ollama local (ar-gapped / offline)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434/v1   # interno ao Docker Compose
# OLLAMA_MODEL=llama3.1:8b                 # CPU 16 GB — equilibrio qualidade/velocidade
# OLLAMA_MODEL=qwen2.5:7b                  # CPU 16 GB — excelente em português
# OLLAMA_MODEL=llama3.3:70b               # GPU 48 GB — qualidade próxima ao Claude
# Para instalar o modelo: .\scripts\setup-ollama.ps1 [-Model <nome>]

# ── Busca Web ─────────────────────────────────────────────────────────────────
# Tavily — registro gratuito em tavily.com
TAVILY_API_KEY=tvly-...

# ── Autenticação ──────────────────────────────────────────────────────────────
JWT_SECRET=gere-um-secret-longo-e-aleatorio-aqui-minimo-32-chars

# ── CORS — URL do frontend ────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:8080

# ── Porta da API ──────────────────────────────────────────────────────────────
PORT=3333

# ── RAG — Voyage AI ───────────────────────────────────────────────────────────
# Registro gratuito em dash.voyageai.com
VOYAGE_API_KEY=pa-...

# ── Alertas KRATOS por e-mail (opcional) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-de-app   # Gmail: "Senhas de app" em myaccount.google.com/security

# ── DOU — INLABS (opcional) ───────────────────────────────────────────────────
# Cadastro gratuito em inlabs.in.gov.br
INLABS_EMAIL=
INLABS_PASSWORD=

# ── ITU DataHub (opcional) ────────────────────────────────────────────────────
# Cadastro gratuito em datahub.itu.int
ITU_EMAIL=
ITU_PASSWORD=

# ── Integrações externas (opcional) ──────────────────────────────────────────
# Webhook n8n para automações (ex: notificações, pipelines externos)
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/...

# ── Notas de desenvolvimento ──────────────────────────────────────────────────
# vizMode — parâmetro de Agent.run() (não é uma env var; documentado aqui para referência)
#   "etapa"    (padrão): análise por etapa, maxTokens=32_000
#   "passos"  : passo-a-passo detalhado, maxTokens=32_000
#   "passagem": processo autônomo completo, maxTokens=16_000
#   "thinking": raciocínio estendido (instrução de prompt; não usa ExtendedThinking API),
#               maxTokens=32_000 — compatibilidade com Ollama depende do modelo
# Configurado pelo frontend em: apps/web/src/stores/sessionStore.ts (campo vizMode)
