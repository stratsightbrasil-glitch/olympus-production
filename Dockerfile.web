# ── OLYMPUS v4 — Web (React/Vite → Nginx) ─────────────────────────────────────
# Stage 1: Build do frontend com Vite
FROM node:20-alpine AS builder

WORKDIR /app
COPY . .
RUN npm install
RUN npm run build --workspace=apps/web

# Stage 2: Servir com Nginx
# nginx.conf usa ${RAILWAY_API_URL} como placeholder — substituído por envsubst
# no startup do container (ver CMD abaixo).
FROM nginx:alpine

# Copia o build do Vite
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copia zonas de rate-limit (contexto http, sem envsubst)
COPY nginx-limits.conf /etc/nginx/conf.d/00-limits.conf

# Copia nginx.conf como template (contém ${RAILWAY_API_URL})
COPY nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

# Startup: usa sed para substituir o placeholder — evita problemas de quoting do envsubst.
# Padrão local Docker Compose: http://api:3333
# Produção Railway:            https://olympus-production-production.up.railway.app
COPY docker-entrypoint-web.sh /docker-entrypoint-web.sh
RUN chmod +x /docker-entrypoint-web.sh

CMD ["/docker-entrypoint-web.sh"]
